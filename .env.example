# URL base da API (backend Django). Termina com barra.
VITE_API_URL=http://localhost:8000/api/

# Simula o envio e identificação de trabalhos por foto no front ("true" ou "false").
VITE_MOCK_TRABALHOS=true

# Simula a extração por IA e o cadastro de atividades a partir de arquivo ("true" ou "false").
VITE_MOCK_ATIVIDADES=true
