# URL base da API (backend Django). Termina com barra.
VITE_API_URL=http://localhost:8000/api/

# Simula o envio e identificação de trabalhos por foto no front ("true" ou "false", padrão: false).
VITE_MOCK_TRABALHOS=false

# Simula a extração por IA e o cadastro de atividades a partir de arquivo ("true" ou "false", padrão: false).
VITE_MOCK_ATIVIDADES=false

# Simula o reconhecimento da chamada por foto e cadastro local de turmas ("true" ou "false", padrão: false).
VITE_MOCK_TURMAS=false
